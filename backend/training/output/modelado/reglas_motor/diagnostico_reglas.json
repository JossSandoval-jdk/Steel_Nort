    "R3b": {
      "diagnostico": "El gasto de CPU es del sistema operativo procesando I/O (drivers/controlador de disco), no de SQL Server procesando lógica de negocio.",
      "detonante": "cpu_time alto sin wait_type claro de CPU, con cpu_sys (% Privileged Time) alto y contadores de disco altos en el mismo instante.",
      "fuente": "Monitor CPU Usage — learn.microsoft.com/en-us/troubleshoot/sql/database-engine/performance/monitor-cpu-usage",
      "n_casos": 30
    },
    "R3": {
      "diagnostico": "Presión real de CPU (no solo un pico puntual de una consulta): planes ineficientes, estadísticas desactualizadas, índices faltantes o parameter sniffing.",
      "detonante": "Espera de planificador (SOS_SCHEDULER_YIELD) o cpu_time muy cercano a duration (la consulta casi no espera y consume CPU todo el tiempo).",
      "fuente": "Troubleshoot High CPU Usage Issues in SQL Server — learn.microsoft.com/en-us/troubleshoot/sql/database-engine/performance/troubleshoot-high-cpu-usage-issues",
      "n_casos": 14
    },
    "R7": {
      "diagnostico": "La consulta se la pasa ejecutando (no esperando) porque tiene que escanear muchas más páginas de las necesarias: plan subóptimo por falta de índice o estadísticas obsoletas; si además hay muchas recompilaciones (ratio compilaciones/batches alto) apunta a falta de parametrización.",
      "detonante": "Sin wait_type dominante (consulta ejecutándose) pero logical_reads=8.0 muy por encima del historial de esa consulta (2).",
      "fuente": "Troubleshoot Slow-Running Queries in SQL Server — learn.microsoft.com/en-us/troubleshoot/sql/database-engine/performance/troubleshoot-slow-running-queries",
      "n_casos": 4
    }
  },
